sel single line, the whole value
  value="hello" view="> hello"
  range=0,5
  highlight="> \x1b[0m\x1b[7mhello\x1b[0m"
  offsetAt(2,10)=0
  offsetAt(4,10)=2
  offsetAt(9,10)=5
  offsetAt(40,10)=5
  offsetAt(2,9)=0
  offsetAt(2,11)=5
  cursor(0)=0,0 value="hello"
  cursor(1)=0,1 value="hello"
  cursor(3)=0,3 value="hello"
  cursor(5)=0,5 value="hello"
  cursor(6)=0,5 value="hello"
  cursor(9)=0,5 value="hello"
  cursor(-1)=0,0 value="hello"
  cursor(-5)=0,0 value="hello"
  delete="" line=0 col=0 sel=false
  replace="X" line=0 col=1 sel=false
sel single line, the middle
  value="hello" view="> hello"
  range=1,3
  highlight="> h\x1b[0m\x1b[7mel\x1b[0mlo"
  offsetAt(3,10)=1
  offsetAt(5,10)=3
  cursor(0)=0,0 value="hello"
  cursor(1)=0,1 value="hello"
  cursor(2)=0,2 value="hello"
  cursor(3)=0,3 value="hello"
  cursor(4)=0,4 value="hello"
  cursor(5)=0,5 value="hello"
  delete="hlo" line=0 col=1 sel=false
  replace="hXYlo" line=0 col=3 sel=false
sel single line, an empty selection
  value="hello" view="> hello"
  range=2,2
  highlight="> hello"
  offsetAt(4,10)=2
  cursor(0)=0,0 value="hello"
  cursor(2)=0,2 value="hello"
  cursor(5)=0,5 value="hello"
  delete="hello" line=0 col=5 sel=false
  replace="hello" line=0 col=5 sel=false
sel single line, past the end of the value
  value="hello" view="> hello"
  range=0,99
  highlight="> \x1b[0m\x1b[7mhello\x1b[0m"
  offsetAt(4,10)=2
  cursor(0)=0,0 value="hello"
  cursor(5)=0,5 value="hello"
  delete="hello" line=0 col=5 sel=false
  replace="hello" line=0 col=5 sel=false
sel single line, a reversed selection
  value="hello" view="> hello"
  range=1,3
  highlight="> h\x1b[0m\x1b[7mel\x1b[0mlo"
  offsetAt(5,10)=3
  cursor(0)=0,0 value="hello"
  cursor(3)=0,3 value="hello"
  delete="hlo" line=0 col=1 sel=false
  replace="hRlo" line=0 col=2 sel=false
sel single line, a selection beyond the value
  value="hello" view="> hello"
  range=9,12
  highlight="> hello"
  offsetAt(4,10)=2
  cursor(0)=0,0 value="hello"
  cursor(5)=0,5 value="hello"
  delete="hello" line=0 col=5 sel=false
  replace="hello" line=0 col=5 sel=false
sel three lines, the whole value
  value="a\nb\nc" view="> a\n  b\n  c"
  range=0,5
  highlight="> \x1b[0m\x1b[7ma\x1b[0m\n  \x1b[0m\x1b[7mb\x1b[0m\n  \x1b[0m\x1b[7mc\x1b[0m"
  offsetAt(2,10)=0
  offsetAt(4,11)=3
  offsetAt(4,12)=5
  offsetAt(4,13)=5
  cursor(0)=0,0 value="a\nb\nc"
  cursor(1)=0,1 value="a\nb\nc"
  cursor(2)=1,0 value="a\nb\nc"
  cursor(3)=1,1 value="a\nb\nc"
  cursor(4)=2,0 value="a\nb\nc"
  cursor(5)=2,1 value="a\nb\nc"
  cursor(6)=2,1 value="a\nb\nc"
  cursor(7)=2,1 value="a\nb\nc"
  delete="" line=0 col=0 sel=false
  replace="Q" line=0 col=1 sel=false
sel three lines, the first row
  value="a\nb\nc" view="> a\n  b\n  c"
  range=0,1
  highlight="> \x1b[0m\x1b[7ma\x1b[0m\n  b\n  c"
  offsetAt(3,10)=1
  cursor(0)=0,0 value="a\nb\nc"
  cursor(1)=0,1 value="a\nb\nc"
  cursor(2)=1,0 value="a\nb\nc"
  delete="\nb\nc" line=0 col=0 sel=false
  replace="F\nb\nc" line=0 col=1 sel=false
sel three lines, the second row only
  value="a\nb\nc" view="> a\n  b\n  c"
  range=2,3
  highlight="> a\n  \x1b[0m\x1b[7mb\x1b[0m\n  c"
  offsetAt(4,11)=3
  cursor(2)=1,0 value="a\nb\nc"
  cursor(3)=1,1 value="a\nb\nc"
  delete="a\n\nc" line=1 col=0 sel=false
  replace="a\nS\nc" line=1 col=1 sel=false
sel an empty value
  value="" view="> "
  range=0,0
  highlight="> "
  offsetAt(2,10)=0
  offsetAt(4,10)=0
  cursor(0)=0,0 value=""
  cursor(1)=0,0 value=""
  cursor(-1)=0,0 value=""
  delete="" line=0 col=0 sel=false
  replace="" line=0 col=0 sel=false
sel wide runes
  value="日本語" view="> 日本語"
  range=0,9
  highlight="> \x1b[0m\x1b[7m日本語\x1b[0m"
  offsetAt(2,10)=0
  offsetAt(4,10)=3
  offsetAt(8,10)=9
  cursor(0)=0,0 value="日本語"
  cursor(3)=0,1 value="日本語"
  cursor(6)=0,2 value="日本語"
  cursor(9)=0,3 value="日本語"
  cursor(12)=0,3 value="日本語"
  delete="" line=0 col=0 sel=false
  replace="漢" line=0 col=1 sel=false
sel a trailing newline
  value="aaa\nbbb\n" view="> aaa\n  bbb\n  "
  range=1,5
  highlight="> a\x1b[0m\x1b[7maa\x1b[0m\n  \x1b[0m\x1b[7mb\x1b[0mbb\n  "
  offsetAt(4,10)=2
  offsetAt(4,11)=6
  offsetAt(4,12)=8
  cursor(0)=0,0 value="aaa\nbbb\n"
  cursor(3)=0,3 value="aaa\nbbb\n"
  cursor(4)=1,0 value="aaa\nbbb\n"
  cursor(7)=1,3 value="aaa\nbbb\n"
  cursor(8)=2,0 value="aaa\nbbb\n"
  delete="abb\n" line=0 col=1 sel=false
  replace="aTbb\n" line=0 col=2 sel=false
sel the prompt on every row
  value="aaa\nbbb" view="> aaa\n  bbb"
  range=1,5
  highlight="> a\x1b[0m\x1b[7maa\x1b[0m\n  \x1b[0m\x1b[7mb\x1b[0mbb"
  offsetAt(4,10)=2
  offsetAt(4,11)=6
  cursor(0)=0,0 value="aaa\nbbb"
  cursor(3)=0,3 value="aaa\nbbb"
  cursor(4)=1,0 value="aaa\nbbb"
  cursor(7)=1,3 value="aaa\nbbb"
  delete="abb" line=0 col=1 sel=false
  replace="aPbb" line=0 col=2 sel=false
sel a value with surrounding spaces
  value="  spaced  " view=">   spaced  "
  range=2,8
  highlight=">   \x1b[0m\x1b[7mspaced\x1b[0m  "
  offsetAt(4,10)=2
  offsetAt(10,10)=8
  cursor(0)=0,0 value="  spaced  "
  cursor(2)=0,2 value="  spaced  "
  cursor(8)=0,8 value="  spaced  "
  cursor(10)=0,10 value="  spaced  "
  delete="    " line=0 col=2 sel=false
  replace="  S  " line=0 col=3 sel=false
